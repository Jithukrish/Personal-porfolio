# Copy to .env.local. Every VITE_ variable is bundled into public client code:
# NEVER put passwords, API keys or secrets here.

# Base URL of an ERPNext site, e.g. https://erp.example.com (leave empty = no backend)
VITE_ERPNEXT_BASE_URL=

# Whitelisted method that receives contact inquiries (guest-allowed)
VITE_ERPNEXT_CONTACT_METHOD=your_app.api.submit_inquiry

# Deploy under a sub-path (e.g. /portfolio/); defaults to /
VITE_BASE_PATH=/
